{
	"name": "metahuman",
	"version": "1.0.0",
	"private": true,
	"description": "An autonomous digital personality extension operating system that mirrors your identity, memories, goals, and personality—operating 24/7 as a seamless extension of yourself",
	"keywords": [
		"ai",
		"artificial-intelligence",
		"digital-personality",
		"autonomous-agents",
		"memory-system",
		"personal-os",
		"llm",
		"ollama"
	],
	"homepage": "https://github.com/Greg-Aster/metahuman-os#readme",
	"bugs": {
		"url": "https://github.com/Greg-Aster/metahuman-os/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Gregory Aster",
		"url": "https://github.com/Greg-Aster"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Greg-Aster/metahuman-os.git"
	},
	"scripts": {
		"preinstall": "node scripts/check-node-runtime.mjs",
		"check:node": "node scripts/check-node-runtime.mjs",
		"postinstall": "node scripts/postinstall.mjs",
		"validate:graphs": "node --import tsx scripts/validate-graphs.ts",
		"sync:graph-artifacts": "node --import tsx scripts/sync-cognitive-graph-artifacts.ts",
		"test:dual-graph": "node --import tsx tests/dual-mode-graph.spec.ts",
		"test:environment-graph": "node --import tsx tests/environment-freestyle-graph.spec.ts",
		"test:model-defaults": "node --import tsx tests/model-defaults.spec.ts",
		"smoke:vision": "node --import tsx scripts/smoke-vision.ts",
		"validate:agent-monitor": "node --import tsx scripts/validate-agent-monitor.ts",
		"validate:security-routes": "node --import tsx scripts/validate-security-routes.ts",
		"validate:node-defaults": "node --import tsx scripts/validate-node-defaults.ts",
		"validate:tts-node-ownership": "node --import tsx packages/core/src/tts-node-ownership.spec.ts",
		"validate:tts-delivery-queue": "node --import tsx packages/core/src/tts/delivery-queue.spec.ts",
		"validate:voice-service-ownership": "node --import tsx packages/core/src/voice-service-ownership.spec.ts",
		"validate:safety": "node --import tsx --test packages/core/src/nodes/safety/safety.spec.ts",
		"validate:training-process": "node --import tsx --test packages/core/src/training-process.spec.ts",
		"validate:environment-action-selector": "node --import tsx --test brain/training/environment-action-selector/corpus.spec.ts brain/training/environment-action-selector/regression.spec.ts",
		"generate:environment-action-selector-training": "node --import tsx brain/training/environment-action-selector/generate-training-data.ts",
		"train:environment-action-selector:0.8b": "node --import tsx brain/training/environment-action-selector/train.ts",
		"evaluate:environment-action-selector:folds": "node --import tsx brain/training/environment-action-selector/evaluate-folds.ts",
		"score:environment-action-selector:development": "node --import tsx brain/training/environment-action-selector/score-development.ts",
		"export:environment-action-selector:merged": "node --import tsx brain/training/environment-action-selector/export-merged.ts",
		"validate:user-agnostic": "node --import tsx scripts/check-user-agnostic.ts",
		"validate:terminal-lifecycle": "node --import tsx packages/core/src/api/handlers/terminal.spec.ts",
		"validate:big-brother-session": "node --import tsx packages/core/src/big-brother-session.spec.ts",
		"audit:graph-executors": "node --import tsx scripts/audit-graph-executors.ts",
		"check:architecture": "node --import tsx scripts/check-architecture.ts",
		"check:architecture:update-baseline": "node --import tsx scripts/check-architecture.ts --update-baseline",
		"audit:inventory": "node --import tsx scripts/create-audit-inventory.ts",
		"audit:fast": "./bin/audit check",
		"typecheck:core": "pnpm --dir packages/core exec tsc --noEmit",
		"typecheck:brain": "pnpm --dir brain typecheck",
		"typecheck:cli": "pnpm --dir packages/cli exec tsc --noEmit",
		"typecheck:agent-runtime": "pnpm --dir packages/agent-runtime exec tsc --noEmit",
		"typecheck:local-model-service": "pnpm --dir packages/local-model-service exec tsc --noEmit",
		"typecheck:scripts": "pnpm exec tsc --project scripts/tsconfig.json",
		"typecheck:tests": "pnpm exec tsc --project tests/tsconfig.json",
		"typecheck:mobile": "pnpm --dir apps/react-native typecheck",
		"typecheck:site": "cd apps/site && pnpm exec astro check",
		"typecheck": "pnpm typecheck:core && pnpm typecheck:brain && pnpm typecheck:cli && pnpm typecheck:agent-runtime && pnpm typecheck:local-model-service && pnpm typecheck:scripts && pnpm typecheck:tests && pnpm typecheck:mobile && pnpm typecheck:site",
		"validate": "pnpm validate:agent-monitor && pnpm validate:security-routes && pnpm validate:node-defaults && pnpm validate:graphs && pnpm validate:tts-node-ownership && pnpm validate:tts-delivery-queue && pnpm validate:voice-service-ownership && pnpm validate:safety && pnpm validate:training-process && pnpm validate:environment-action-selector && pnpm validate:user-agnostic && pnpm validate:terminal-lifecycle && pnpm validate:big-brother-session",
		"test": "pnpm test:model-defaults && pnpm test:dual-graph && pnpm test:environment-graph && pnpm validate",
		"dev": "cd apps/site && NODE_OPTIONS='--max-old-space-size=4096' pnpm dev",
		"build": "pnpm typecheck && pnpm check:architecture && pnpm test && pnpm --dir apps/site build",
		"start": "cd apps/site && pnpm preview",
		"mobile:dev": "pnpm --dir apps/react-native dev",
		"mobile:build": "pnpm --dir apps/react-native build"
	},
	"packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
	"engines": {
		"node": ">=22.3.0 <23",
		"pnpm": ">=10.15.1 <11"
	},
	"devDependencies": {
		"@types/node": "^24.9.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
