{
  "version": "2.0.0",
  "description": "Psychoanalyzer configuration for evidence-backed persona learning",
  "enabled": true,
  "memorySelection": {
    "strategy": "priority_recent",
    "daysBack": 30,
    "maxMemories": 30,
    "minMemories": 5,
    "excludeTypes": ["audit", "system", "inner_dialogue", "reflection", "reflection_summary", "dream", "curiosity_question", "summary"],
    "priorityTags": ["insight", "goal", "value", "decision"],
    "userInputOnly": true
  },
  "analysis": {
    "model": "psychotherapist",
    "temperature": 0.3,
    "maxTokens": 2200,
    "confidenceThreshold": 0.7
  },
  "updateStrategy": {
    "preserveUserEdits": true,
    "fields": {
      "personality.traits": true,
      "personality.communicationStyle": true,
      "personality.interests": true,
      "values.core": true,
      "goals": true,
      "context.domains": true,
      "context.currentFocus": true,
      "context.projects": true,
      "decisionHeuristics": true,
      "writingStyle.motifs": true
    }
  },
  "reconciliation": {
    "removeStaleGoals": true,
    "removeStaleInterests": true,
    "removeContradictedValues": true,
    "removeUnusedHeuristics": true
  },
  "insights": {
    "enabled": true,
    "maxEntries": 100
  }
}
