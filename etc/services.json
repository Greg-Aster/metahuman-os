{
  "version": "1.0.0",
  "description": "Persistent service lifecycle configuration",
  "services": {
    "environment-bridge": {
      "id": "environment-bridge",
      "enabled": true,
      "type": "manual",
      "priority": "high",
      "agentPath": "environment-bridge/index.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "adapterUrl": "ws://127.0.0.1:8790/environment",
      "graph": "environment",
      "comment": "Generic event-driven environment adapter connection."
    },
    "robot-operator": {
      "id": "robot-operator",
      "enabled": true,
      "type": "manual",
      "priority": "normal",
      "agentPath": "services/robot-operator.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "boredomObserverInactivityThreshold": 300,
      "boredomObserverJitterMs": 60000,
      "boredomMovementInactivityThreshold": 600,
      "boredomMovementJitterMs": 120000,
      "boredomReflectionInactivityThreshold": 900,
      "boredomReflectionJitterMs": 180000,
      "maxCycleSteps": 8,
      "boredomObserverGraph": "boredom-observer",
      "boredomMovementGraph": "boredom-movement",
      "boredomReflectionGraph": "boredom-reflection",
      "autonomyGraph": "boredom-autonomy",
      "environmentGraph": "environment",
      "comment": "Robot-autonomy scheduler and admission owner. Semi mode uses independent idle timers; full mode rotates continuously across the three named child planners between cooldowns. Each child graph authors one contextual intention; Boredom Autonomy executes and revises it from correlated results."
    },
    "maintenance-service": {
      "id": "maintenance-service",
      "enabled": true,
      "type": "manual",
      "priority": "normal",
      "agentPath": "services/maintenance-service.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "comment": "Maintenance-only service for stale-lock health checks, audit-log cleanup, and embedding preload."
    }
  }
}
