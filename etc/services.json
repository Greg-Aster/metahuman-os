{
  "version": "1.0.0",
  "description": "Persistent service lifecycle configuration",
  "services": {
    "robot-operator": {
      "id": "robot-operator",
      "enabled": true,
      "type": "manual",
      "priority": "normal",
      "agentPath": "active-operator/index.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "robotStatusGraph": "robot-status",
      "robotAutonomyControllerGraph": "robot-autonomy-controller",
      "robotGoalReviewGraph": "robot-goal-review",
      "boredomObserverGraph": "boredom-observer",
      "boredomMovementGraph": "boredom-movement",
      "boredomReflectionGraph": "boredom-reflection",
      "environmentGraph": "environment",
      "comment": "Active Operator agent lifecycle and robot-autonomy configuration. Reactive keeps the agent dormant. Semi requests each operation updated to 100% activation. Full requests the highest returned activation. Selected work runs independently of subsequent assessments. The robot-operator identity is retained for existing settings and durable work."
    },
    "maintenance-service": {
      "id": "maintenance-service",
      "enabled": true,
      "type": "manual",
      "priority": "normal",
      "agentPath": "services/maintenance-service.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "comment": "Maintenance-only service for stale-lock health checks, audit-log cleanup, and embedding preload."
    },
    "terminal": {
      "id": "terminal",
      "enabled": true,
      "type": "manual",
      "priority": "normal",
      "agentPath": "services/terminal.ts",
      "usesLLM": false,
      "startOnSystemBoot": false,
      "autoRestart": false,
      "maxRetries": 0,
      "comment": "On-demand shell and Big Brother session owner. Stopping closes all owned sessions."
    },
    "environment-bridge-local": {
      "id": "environment-bridge-local",
      "enabled": true,
      "type": "manual",
      "priority": "high",
      "agentPath": "environment-bridge/local.ts",
      "usesLLM": false,
      "startOnSystemBoot": true,
      "autoRestart": true,
      "maxRetries": 3,
      "adapterUrl": "ws://127.0.0.1:8790/environment",
      "graph": "environment",
      "comment": "Environment Bridge Local; starting switches the active connection."
    },
    "environment-bridge-remote": {
      "id": "environment-bridge-remote",
      "enabled": true,
      "type": "manual",
      "priority": "high",
      "agentPath": "environment-bridge/remote.ts",
      "usesLLM": false,
      "startOnSystemBoot": false,
      "autoRestart": true,
      "maxRetries": 3,
      "adapterUrl": "ws://127.0.0.1:18790/environment",
      "graph": "environment",
      "comment": "Environment Bridge Remote; starting switches the active connection.",
      "cloudflareHostname": "bridge.ainek.io",
      "accessEnvFile": "/home/greggles/.cloudflared/ainekio-environment-access.env"
    }
  }
}
