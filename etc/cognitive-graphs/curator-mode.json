{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Curator Workflow",
  "description": "Validates episodic memories into canonical curated conversation records, then marks only durably saved sources",
  "cognitiveMode": "agent",
  "last_modified": "2026-08-24",
  "nodes": [
    {
      "id": "1",
      "type": "curatorNode",
      "position": {
        "x": 100,
        "y": 200
      },
      "data": {
        "label": "Load Uncurated Memories",
        "nodeType": "uncurated_memory_loader",
        "properties": {
          "limit": 20
        }
      },
      "width": 220,
      "height": 100
    },
    {
      "id": "2",
      "type": "curatorNode",
      "position": {
        "x": 100,
        "y": 350
      },
      "data": {
        "label": "Load Persona Context",
        "nodeType": "persona_summary_loader",
        "properties": {}
      },
      "width": 220,
      "height": 80
    },
    {
      "id": "4",
      "type": "curatorNode",
      "position": {
        "x": 400,
        "y": 200
      },
      "data": {
        "label": "Curate Memories (LLM)",
        "nodeType": "curator_llm",
        "properties": {
          "temperature": 0.3,
          "timeout": 300000
        }
      },
      "width": 220,
      "height": 140
    },
    {
      "id": "5",
      "type": "curatorNode",
      "position": {
        "x": 700,
        "y": 100
      },
      "data": {
        "label": "Save Curated Memories",
        "nodeType": "curated_memory_saver",
        "properties": {}
      },
      "width": 220,
      "height": 80
    },
    {
      "id": "8",
      "type": "curatorNode",
      "position": {
        "x": 1000,
        "y": 200
      },
      "data": {
        "label": "Mark as Curated",
        "nodeType": "memory_marker",
        "properties": {}
      },
      "width": 220,
      "height": 80
    },
    {
      "id": "9",
      "type": "outputNode",
      "position": {
        "x": 1300,
        "y": 200
      },
      "data": {
        "label": "Audit Completion",
        "nodeType": "audit_logger",
        "properties": {
          "event": "curator_completed"
        }
      },
      "width": 180,
      "height": 60
    }
  ],
  "edges": [
    {
      "id": "e-1-memories-4-memories",
      "source": "1",
      "target": "4",
      "sourceHandle": "memories",
      "targetHandle": "memories",
      "data": {
        "type": "object",
        "comment": "Uncurated memories → Curator LLM"
      }
    },
    {
      "id": "e-2-personaSummary-4-personaSummary",
      "source": "2",
      "target": "4",
      "sourceHandle": "personaSummary",
      "targetHandle": "personaSummary",
      "data": {
        "type": "string",
        "comment": "Persona summary → Curator LLM (context)"
      }
    },
    {
      "id": "e-4-curatedMemories-5-curatedMemories",
      "source": "4",
      "target": "5",
      "sourceHandle": "curatedMemories",
      "targetHandle": "curatedMemories",
      "data": {
        "type": "object",
        "comment": "Curated memories → Save"
      }
    },
    {
      "id": "e-5-curatedMemories-8-curatedMemories",
      "source": "5",
      "target": "8",
      "sourceHandle": "curatedMemories",
      "targetHandle": "curatedMemories",
      "data": {
        "type": "object",
        "comment": "Durably saved curation results → Mark source memories"
      }
    },
    {
      "id": "e-8-markedCount-9-eventType",
      "source": "8",
      "target": "9",
      "sourceHandle": "markedCount",
      "targetHandle": "eventType",
      "data": {
        "type": "number",
        "comment": "Committed source count → Audit Logger"
      }
    }
  ]
}
