{
  "version": "2.0",
  "format": "svelte-flow",
  "scheduler": { "version": 1, "activation": "demand", "skippedState": "explicit", "sideEffectOrder": "serial-topological", "maxLoopIterations": 5 },
  "name": "Train of Thought Workflow",
  "description": "Extends one supplied thought or bounded profile-memory seed through related historical memories, then durably admits the resulting reasoning chain",
  "cognitiveMode": "agent",
  "last_modified": "2026-08-29",
  "nodes": [
    {
      "id": "seed",
      "type": "inputNode",
      "position": { "x": 60, "y": 180 },
      "width": 200,
      "height": 80,
      "data": {
        "label": "Thought or Memory Seed",
        "nodeType": "text_input",
        "properties": { "inputKey": "seedMemory" }
      }
    },
    {
      "id": "generate",
      "type": "cognitiveNode",
      "position": { "x": 340, "y": 180 },
      "width": 220,
      "height": 110,
      "data": {
        "label": "Generate New Connection",
        "nodeType": "thought_generator",
        "properties": {
          "temperature": 0.75,
          "extractKeywords": true,
          "maxTokens": 512,
          "timeout": 300000
        }
      }
    },
    {
      "id": "evaluate",
      "type": "cognitiveNode",
      "position": { "x": 640, "y": 180 },
      "width": 220,
      "height": 100,
      "data": {
        "label": "Evaluate Continuation",
        "nodeType": "thought_evaluator",
        "properties": { "minConfidence": 0.4, "maxIterations": 4 }
      }
    },
    {
      "id": "search",
      "type": "cognitiveNode",
      "position": { "x": 920, "y": 180 },
      "width": 230,
      "height": 110,
      "data": {
        "label": "Find Related Memories",
        "nodeType": "loop_memory_search",
        "properties": { "maxResults": 3, "excludeSeen": true }
      }
    },
    {
      "id": "route",
      "type": "routerNode",
      "position": { "x": 1210, "y": 180 },
      "width": 220,
      "height": 100,
      "data": {
        "label": "Continue or Aggregate",
        "nodeType": "conditional_router",
        "properties": {}
      }
    },
    {
      "id": "aggregate",
      "type": "cognitiveNode",
      "position": { "x": 1510, "y": 180 },
      "width": 230,
      "height": 110,
      "data": {
        "label": "Aggregate Thought Chain",
        "nodeType": "thought_aggregator",
        "properties": {
          "summaryStyle": "narrative",
          "maxLength": 200,
          "maxTokens": 800,
          "timeout": 300000
        }
      }
    },
    {
      "id": "persist",
      "type": "outputNode",
      "position": { "x": 1810, "y": 180 },
      "width": 230,
      "height": 100,
      "data": {
        "label": "Admit Inner Reasoning",
        "nodeType": "inner_dialogue_buffer",
        "properties": {
          "tags": ["train-of-thought", "associative", "inner"],
          "dialogueSource": "train-of-thought",
          "displayColor": "#8b5cf6",
          "role": "reasoning"
        }
      }
    },
    {
      "id": "memory",
      "type": "cognitiveNode",
      "position": { "x": 2100, "y": 180 },
      "width": 240,
      "height": 100,
      "data": {
        "label": "Save Inner Reasoning Memory",
        "nodeType": "inner_dialogue_saver",
        "properties": {}
      }
    },
    {
      "id": "audit",
      "type": "outputNode",
      "position": { "x": 2390, "y": 180 },
      "width": 190,
      "height": 80,
      "data": {
        "label": "Audit Persisted Chain",
        "nodeType": "audit_logger",
        "properties": {
          "category": "agent",
          "event": "train_of_thought_persisted",
          "level": "info"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-seed-generate",
      "source": "seed",
      "target": "generate",
      "sourceHandle": "text",
      "targetHandle": "seedMemory",
      "data": { "type": "string", "comment": "Explicit upstream result or bounded sampled memory" }
    },
    {
      "id": "e-generate-evaluate",
      "source": "generate",
      "target": "evaluate",
      "sourceHandle": "thoughtData",
      "targetHandle": "thoughtData",
      "data": { "type": "object", "comment": "New thought and accumulated chain state" }
    },
    {
      "id": "e-evaluate-search",
      "source": "evaluate",
      "target": "search",
      "sourceHandle": "evaluation",
      "targetHandle": "evaluation",
      "data": { "type": "object", "comment": "Continuation decision and search terms" }
    },
    {
      "id": "e-search-route-condition",
      "source": "search",
      "target": "route",
      "sourceHandle": "shouldExit",
      "targetHandle": "condition",
      "data": { "type": "boolean", "comment": "Exit when complete or no new related memory exists" }
    },
    {
      "id": "e-search-route-exit",
      "source": "search",
      "target": "route",
      "sourceHandle": "exitData",
      "targetHandle": "trueData",
      "data": { "type": "object", "comment": "Completed chain for aggregation" }
    },
    {
      "id": "e-search-route-loop",
      "source": "search",
      "target": "route",
      "sourceHandle": "context",
      "targetHandle": "falseData",
      "data": { "type": "object", "comment": "Related memories for the next thought" }
    },
    {
      "id": "e-route-generate",
      "source": "route",
      "target": "generate",
      "sourceHandle": "routedData",
      "targetHandle": "context",
      "data": {
        "type": "object",
        "comment": "Continue from related memories",
        "loop": true,
        "when": { "output": "branch", "equals": "false" }
      }
    },
    {
      "id": "e-route-aggregate",
      "source": "route",
      "target": "aggregate",
      "sourceHandle": "routedData",
      "targetHandle": "thoughtData",
      "data": {
        "type": "object",
        "comment": "Aggregate only after the router exits",
        "when": { "output": "branch", "equals": "true" }
      }
    },
    {
      "id": "e-aggregate-persist",
      "source": "aggregate",
      "target": "persist",
      "sourceHandle": "result",
      "targetHandle": "text",
      "data": { "type": "string", "comment": "Durably admit the complete reasoning chain" }
    },
    {
      "id": "e-persist-memory",
      "source": "persist",
      "target": "memory",
      "sourceHandle": "entries",
      "targetHandle": "entries",
      "data": { "type": "array", "comment": "Only admitted reasoning enters long-term Persona Memory" }
    },
    {
      "id": "e-memory-audit",
      "source": "memory",
      "target": "audit",
      "sourceHandle": "saved",
      "targetHandle": "status",
      "data": { "type": "boolean", "comment": "Audit only confirmed long-term persistence without copying private content" }
    }
  ]
}
