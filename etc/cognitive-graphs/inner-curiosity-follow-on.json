{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Inner Curiosity Follow-on Workflow",
  "description": "Optionally admits a Train of Thought task seeded by one durably persisted private curiosity result",
  "cognitiveMode": "agent",
  "last_modified": "2026-08-29",
  "nodes": [
    {
      "id": "seed",
      "type": "inputNode",
      "position": { "x": 100, "y": 100 },
      "width": 210,
      "height": 80,
      "data": {
        "label": "Persisted Curiosity Result",
        "nodeType": "text_input",
        "properties": { "inputKey": "followOnSeed" }
      }
    },
    {
      "id": "trigger",
      "type": "cognitiveNode",
      "position": { "x": 400, "y": 100 },
      "width": 240,
      "height": 100,
      "data": {
        "label": "Optional Thought Follow-on",
        "nodeType": "agent_trigger",
        "properties": {
          "agentName": "train-of-thought",
          "sourceAgent": "inner-curiosity",
          "probability": 0.2
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-seed-trigger",
      "source": "seed",
      "target": "trigger",
      "sourceHandle": "text",
      "targetHandle": "seed",
      "data": { "type": "string", "comment": "Persisted private Q&A may seed a new associative thought chain" }
    }
  ]
}
