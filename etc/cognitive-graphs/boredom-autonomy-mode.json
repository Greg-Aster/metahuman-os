      "id": "bridge-out",
      "type": "environmentNode",
      "position": { "x": 2470, "y": 210 },
      "data": {
        "label": "Execute One Consequence and Yield",
        "nodeType": "environment_send_action",
        "properties": {
          "allowedActions": ["move", "look", "jump", "interact", "stop", "captureImage", "robotCommand", "robotMotionPlan", "inspect", "visualApproach", "sendText"],
          "maxDurationMs": 5000,
          "defaultDurationMs": 750,
          "feedbackGraph": "boredom-autonomy"
        }
      }
    },
    { "id": "robot-buffer", "type": "outputNode", "position": { "x": 2790, "y": 20 }, "data": { "label": "Robot Action Record", "nodeType": "robot_buffer", "properties": { "recordNoAction": false } } },
    { "id": "conversation-buffer", "type": "outputNode", "position": { "x": 2790, "y": 310 }, "data": { "label": "Voiced Conversation", "nodeType": "conversation_buffer", "properties": {} } },
    { "id": "conversation-memory", "type": "outputNode", "position": { "x": 3090, "y": 450 }, "data": { "label": "Conversation Memory Saver", "nodeType": "memory_capture", "properties": {} } },
    { "id": "tts-out", "type": "outputNode", "position": { "x": 3090, "y": 310 }, "data": { "label": "Speak Deliberate Conversation", "nodeType": "tts", "properties": { "source": "boredom-autonomy", "defaultMode": "conversation" } } }
