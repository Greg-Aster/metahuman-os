{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Autonomy Mode",
  "description": "Executes a boredom planner's self-authored intention and uses canonical Environment Task State to revise it from correlated action results and fresh evidence.",
  "cognitiveMode": "environment",
  "last_modified": "2026-08-25",
  "nodes": [
    { "id": "observation", "type": "environmentNode", "position": { "x": 40, "y": 220 }, "data": { "label": "Current Robot Stimulus or Result", "nodeType": "environment_observation", "properties": {} } },
    { "id": "trigger-instruction", "type": "inputNode", "position": { "x": 40, "y": 20 }, "data": { "label": "Incoming Boredom Stimulus", "nodeType": "text_input", "properties": { "message": "", "inputKey": "environmentTaskInstruction" } } },
    { "id": "task-state-prepare", "type": "environmentNode", "position": { "x": 340, "y": 20 }, "data": { "label": "Prepare Autonomy Objective", "nodeType": "environment_task_state", "properties": { "phase": "prepare" } } },
    {
      "id": "executive-policy",
      "type": "inputNode",
      "position": { "x": 340, "y": -190 },
      "data": {
        "label": "Boredom Autonomy Executive Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Autonomy executor. Use the planner-authored intention with the active persona, current Environment Task State, fresh correlated evidence, recent conversation and reflection, verified prior actions, sampled memory, current state, and advertised capabilities. Choose one supported consequence for this pass: a deliberate response, one exact advertised action, or one supported body-local movement request. Preserve the intended kind of consequence: a physical or sensing intention must become a structured action or movementRequest, not response-only completion. Prefer an exact advertised action whose meaning fits; use movementRequest only when no advertised action expresses the intended body-local change. Do not replace the intention with a generic idle task or ask the user to decide what happens.\n\nAfter an action, interpret its correlated result, preserve or revise the objective from evidence, and choose the next consequence while the interest remains. Action completion is evidence, not automatic episode completion. Historical narrative may guide meaning but cannot prove present physical facts.\n\nReturn strict JSON with exactly response, actions, movementRequest, and taskDecision. Include a non-empty objective, reason, outcome, objectiveComplete, continuationPolicy, and requiredCompletionBasis. Physical work uses outcome=act and objectiveComplete=false. An unfinished episode includes one action or movementRequest now; otherwise give the substantive response that resolves it and mark it complete. Never promise an absent action.",
          "inputKey": ""
        }
      }
    },
    { "id": "image-input", "type": "environmentNode", "position": { "x": 340, "y": 410 }, "data": { "label": "Fresh Correlated Image", "nodeType": "environment_image_input", "properties": {} } },
    { "id": "conversation-history", "type": "contextNode", "position": { "x": 40, "y": 550 }, "data": { "label": "Recent Conversation", "nodeType": "conversation_history", "properties": { "mode": "conversation", "limit": 4 } } },
    { "id": "inner-history", "type": "contextNode", "position": { "x": 40, "y": 700 }, "data": { "label": "Recent Private Reflection", "nodeType": "conversation_history", "properties": { "mode": "inner", "limit": 4 } } },
    { "id": "robot-history", "type": "contextNode", "position": { "x": 40, "y": 850 }, "data": { "label": "Verified Robot Action History", "nodeType": "conversation_history", "properties": { "mode": "robot", "limit": 20 } } },
    { "id": "persona-loader", "type": "personaNode", "position": { "x": 340, "y": 650 }, "data": { "label": "Active Persona", "nodeType": "persona_loader", "properties": {} } },
    { "id": "persona-formatter", "type": "personaNode", "position": { "x": 640, "y": 650 }, "data": { "label": "Compact Persona Context", "nodeType": "persona_formatter", "properties": { "includeValues": true, "includeGoals": true, "includePersonality": true } } },
    { "id": "autonomy-context", "type": "operatorNode", "position": { "x": 680, "y": 180 }, "data": { "label": "Build Bounded Autonomy Context", "nodeType": "robot_operator_context_builder", "properties": {} } },
    { "id": "autonomy-selector", "type": "llmNode", "position": { "x": 1060, "y": 210 }, "data": { "label": "Choose the Next Episode Consequence", "nodeType": "model_router", "properties": { "role": "environmentActionSelector", "maxTokens": 384, "temperature": 0.55, "format": "json" } } },
    { "id": "action-parser", "type": "environmentNode", "position": { "x": 1340, "y": 210 }, "data": { "label": "Validate Selected Consequence", "nodeType": "environment_action_parser", "properties": {} } },
    { "id": "movement-generator", "type": "environmentNode", "position": { "x": 1870, "y": -40 }, "data": { "label": "Optional Novel Body Movement", "nodeType": "movement_generator", "properties": { "role": "orchestrator", "maxTokens": 1536, "temperature": 0.2 } } },
    { "id": "task-state-reduce", "type": "environmentNode", "position": { "x": 2160, "y": 190 }, "data": { "label": "Reduce Autonomy Objective", "nodeType": "environment_task_state", "properties": { "phase": "reduce" } } },
    {
      "id": "bridge-out",
      "type": "environmentNode",
      "position": { "x": 2470, "y": 210 },
      "data": {
        "label": "Execute One Consequence and Yield",
        "nodeType": "environment_send_action",
        "properties": {
          "allowedActions": ["move", "look", "jump", "interact", "stop", "captureImage", "robotCommand", "robotMotionPlan", "inspect", "visualApproach", "sendText"],
          "maxDurationMs": 5000,
          "defaultDurationMs": 750,
          "feedbackGraph": "boredom-autonomy"
        }
      }
    },
    { "id": "robot-buffer", "type": "outputNode", "position": { "x": 2790, "y": 20 }, "data": { "label": "Robot Action Record", "nodeType": "robot_buffer", "properties": { "recordNoAction": false } } },
    { "id": "conversation-buffer", "type": "outputNode", "position": { "x": 2790, "y": 310 }, "data": { "label": "Voiced Conversation", "nodeType": "conversation_buffer", "properties": {} } },
    { "id": "tts-out", "type": "outputNode", "position": { "x": 3090, "y": 310 }, "data": { "label": "Speak Deliberate Conversation", "nodeType": "tts", "properties": { "source": "boredom-autonomy", "defaultMode": "conversation" } } }
  ],
