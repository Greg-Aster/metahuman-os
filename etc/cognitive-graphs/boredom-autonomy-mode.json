      "data": {
        "label": "Execute One Action and End",
        "nodeType": "environment_send_action",
        "properties": {
          "allowedActions": [
            "move",
            "look",
            "jump",
            "interact",
            "stop",
            "captureImage",
            "robotCommand",
            "robotMotionPlan",
            "inspect",
            "visualApproach",
            "sendText"
          ],
          "maxDurationMs": 5000,
          "defaultDurationMs": 750,
          "feedbackGraph": "robot-action-result"
        },
        "comment": "Dispatches one LLM-selected advertised action or generated fallback movement. Returned success or failure goes once to Robot Action Result; this workflow never re-enters itself.",
