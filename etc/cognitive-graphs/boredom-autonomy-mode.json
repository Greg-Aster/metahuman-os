{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Autonomy Mode",
  "description": "Executes a boredom planner's self-authored intention and uses canonical Environment Task State to revise it from correlated action results and fresh evidence.",
  "cognitiveMode": "environment",
  "last_modified": "2026-09-02",
  "nodes": [
    { "id": "observation", "type": "environmentNode", "position": { "x": 40, "y": 220 }, "data": { "label": "Current Robot Stimulus and Planner Handoff", "nodeType": "environment_bridge_input", "properties": {}, "comment": "Reads the observation that triggered this autonomy cycle, including planner provenance and selected perception/state data. It does not choose or send an action." } },
    { "id": "trigger-instruction", "type": "inputNode", "position": { "x": 40, "y": 20 }, "data": { "label": "Resolve Planner Instruction", "nodeType": "instruction_resolver", "properties": {} } },
    { "id": "task-state-prepare", "type": "environmentNode", "position": { "x": 340, "y": 20 }, "data": { "label": "Prepare Autonomy Objective", "nodeType": "environment_task_state", "properties": { "phase": "prepare" } } },
    {
      "id": "executive-policy",
      "type": "inputNode",
      "position": { "x": 340, "y": -190 },
      "data": {
        "label": "Boredom Autonomy Executive Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Autonomy executor. Use the complete plannerDecision (observed, instruction, and reason), persona, Environment Task State, Robot Status, current evidence, recent conversation/reflection, verifiedActionHistory, memory, state, and advertised capabilities. The planner's desired effect is authoritative intent; correlated evidence is authoritative physical context. Choose a response, exact action, or body-local movementRequest. Use robotCommandDescriptions to understand exact commands, including punctuation-only names. For the current step, prefer an exact command whose described effect fits; use movementRequest only when that movement is uncovered. Recent actions may break a genuine tie, but contextual fit comes first. Physical or sensing intent requires an action or movementRequest, not response-only completion. Do not replace the intention with a generic idle task.\n\nAfter an action, interpret its correlated result; preserve or revise the objective from evidence. Action completion is evidence, not automatic episode completion. Continue, revise, repeat, or complete from the objective and current evidence; do not impose a fixed action count or deterministic stop. Darkness or occlusion is missing evidence, not proof of hidden activity, heat, or an unsupported sensor reading. Robot Status and narrative cannot prove present physical facts.\n\nReturn strict JSON: response, actions, movementRequest, and taskDecision with objective, reason, outcome, objectiveComplete, continuationPolicy, and requiredCompletionBasis. Physical work uses outcome=act and objectiveComplete=false. An unfinished episode includes an action or movementRequest; otherwise mark it complete. Outward response is always optional; leave response empty when speaking adds nothing. If present, use one or two concise sentences. Never promise an absent action.",
          "inputKey": ""
        }
      }
    },
    { "id": "image-input", "type": "environmentNode", "position": { "x": 340, "y": 410 }, "data": { "label": "Fresh Correlated Image", "nodeType": "environment_image_input", "properties": {} } },
    { "id": "conversation-history", "type": "contextNode", "position": { "x": 40, "y": 550 }, "data": { "label": "Recent Conversation", "nodeType": "conversation_history", "properties": { "mode": "conversation", "limit": 4 } } },
    { "id": "inner-history", "type": "contextNode", "position": { "x": 40, "y": 700 }, "data": { "label": "Recent Private Reflection", "nodeType": "conversation_history", "properties": { "mode": "inner", "limit": 4 } } },
    { "id": "robot-history", "type": "contextNode", "position": { "x": 40, "y": 850 }, "data": { "label": "Verified Robot Action History", "nodeType": "conversation_history", "properties": { "mode": "robot", "limit": 20 } } },
    { "id": "robot-status", "type": "contextNode", "position": { "x": 340, "y": 850 }, "data": { "label": "Current Robot Status", "nodeType": "robot_status", "properties": { "historyLimit": 3 } } },
    { "id": "persona-loader", "type": "personaNode", "position": { "x": 340, "y": 650 }, "data": { "label": "Active Persona", "nodeType": "persona_loader", "properties": {} } },
    { "id": "persona-formatter", "type": "personaNode", "position": { "x": 640, "y": 650 }, "data": { "label": "Compact Persona Context", "nodeType": "persona_formatter", "properties": { "includeValues": true, "includeGoals": true, "includePersonality": true } } },
    { "id": "autonomy-context", "type": "operatorNode", "position": { "x": 680, "y": 180 }, "data": { "label": "Build Bounded Autonomy Context", "nodeType": "robot_operator_context_builder", "properties": {} } },
    { "id": "autonomy-selector", "type": "llmNode", "position": { "x": 1060, "y": 210 }, "data": { "label": "Choose the Next Episode Consequence", "nodeType": "model_router", "properties": { "role": "environmentActionSelector", "maxTokens": 2048, "temperature": 0.55, "format": "json" } } },
    { "id": "action-parser", "type": "environmentNode", "position": { "x": 1340, "y": 210 }, "data": { "label": "Validate Selected Consequence", "nodeType": "environment_action_parser", "properties": {} } },
    { "id": "movement-generator", "type": "environmentNode", "position": { "x": 1870, "y": -40 }, "data": { "label": "Optional Novel Body Movement", "nodeType": "movement_generator", "properties": { "role": "orchestrator", "maxTokens": 4096, "temperature": 0.2 } } },
    { "id": "task-state-reduce", "type": "environmentNode", "position": { "x": 2160, "y": 190 }, "data": { "label": "Reduce Autonomy Objective", "nodeType": "environment_task_state", "properties": { "phase": "reduce" } } },
