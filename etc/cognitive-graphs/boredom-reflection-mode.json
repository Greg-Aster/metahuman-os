{
  "version": "1.0",
  "format": "svelte-flow",
  "scheduler": { "version": 1, "activation": "demand", "skippedState": "explicit", "sideEffectOrder": "serial-topological", "maxLoopIterations": 5 },
  "name": "Boredom Reflection Mode",
  "description": "Uses a sampled memory with Robot Status, persona, recent narrative, current bridge state, and verified action history to author one consequential intention for Robot Autonomy Executor.",
  "cognitiveMode": "environment",
  "last_modified": "2026-09-04",
  "nodes": [
    {
      "id": "observation",
      "type": "environmentNode",
      "position": { "x": 40, "y": 260 },
      "data": {
        "label": "Current Robot State and Capabilities",
        "nodeType": "environment_bridge_input",
        "properties": {},
        "comment": "Makes the complete read-only Environment Bridge contract available. This workflow connects only current state and capabilities for reflection; the input node has no prompt or direct effect."
      }
    },
    {
      "id": "planner-policy",
      "type": "inputNode",
      "position": { "x": 40, "y": -80 },
      "data": {
        "label": "Editable Reflection Planner Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Reflection planner. Let the sampled memory interact with the active persona, recent conversation and reflection, current robot state, and verified prior actions to form one new high-level intention with a consequence now. Preserve a concrete connection to the memory without merely summarizing it or treating it as present-world evidence. Do not choose a technical command, completion rule, or execution sequence. Return only the configured JSON decision.",
          "inputKey": ""
        }
      }
    },
    { "id": "robot-operator-input", "type": "operatorNode", "position": { "x": 560, "y": 100 }, "data": { "label": "Robot Operator Input", "nodeType": "robot_operator_input", "properties": {} } },
    {
      "id": "robot-status",
      "type": "contextNode",
      "position": { "x": 820, "y": 700 },
      "data": {
        "label": "Current Robot Status",
        "nodeType": "robot_status",
        "properties": { "historyLimit": 3 }
      }
    },
    {
      "id": "memory-sampler",
      "type": "memoryNode",
      "position": { "x": 40, "y": 500 },
      "data": {
        "label": "Sample Historical Memory",
        "nodeType": "curiosity_weighted_sampler",
        "properties": { "sampleSize": 1, "decayFactor": 30 }
      }
    },
    {
      "id": "conversation-history",
      "type": "contextNode",
      "position": { "x": 300, "y": 500 },
      "data": {
        "label": "Recent Conversation",
        "nodeType": "conversation_history",
        "properties": { "mode": "conversation", "limit": 4 }
      }
    },
    {
      "id": "inner-history",
      "type": "contextNode",
      "position": { "x": 560, "y": 500 },
      "data": {
        "label": "Recent Reflection",
        "nodeType": "conversation_history",
        "properties": { "mode": "inner", "limit": 2 }
      }
    },
    {
      "id": "robot-history",
      "type": "contextNode",
      "position": { "x": 820, "y": 500 },
      "data": {
        "label": "Verified Robot Action History",
        "nodeType": "conversation_history",
        "properties": { "mode": "robot", "limit": 20 }
      }
    },
    {
      "id": "persona-loader",
      "type": "personaNode",
      "position": { "x": 300, "y": 700 },
      "data": {
        "label": "Active Persona",
        "nodeType": "persona_loader",
        "properties": {}
      }
    },
    {
      "id": "persona-formatter",
      "type": "personaNode",
      "position": { "x": 560, "y": 700 },
      "data": {
        "label": "Compact Persona Context",
        "nodeType": "persona_formatter",
        "properties": {
          "includeValues": true,
          "includeGoals": true,
          "includePersonality": true
        }
      }
    },
    {
      "id": "planner-context",
      "type": "operatorNode",
      "position": { "x": 1110, "y": 220 },
      "data": {
        "label": "Build Reflection Planning Context",
        "nodeType": "robot_operator_context_builder",
        "properties": { "outputContract": "delegation" }
      }
    },
    {
      "id": "planner",
      "type": "llmNode",
      "position": { "x": 1500, "y": 220 },
      "data": {
        "label": "Author Memory-Inspired Intention",
        "nodeType": "model_router",
        "properties": {
          "role": "persona",
          "maxTokens": 384,
          "temperature": 0.75,
          "format": "json"
        }
      }
    },
    {
      "id": "decision-parser",
      "type": "operatorNode",
      "position": { "x": 1790, "y": 220 },
      "data": {
        "label": "Validate Planner Instruction",
        "nodeType": "robot_operator_decision_parser",
        "properties": {}
      }
    },
    {
      "id": "environment-dispatch",
      "type": "operatorNode",
      "position": { "x": 2100, "y": 220 },
      "data": {
        "label": "Send Intention to Robot Autonomy Executor",
        "nodeType": "robot_operator_environment_dispatch",
        "properties": { "graph": "boredom-autonomy" }
      }
    }
  ],
  "edges": [
    { "id": "e-robot-observer-planner", "source": "robot-operator-input", "target": "planner-context", "sourceHandle": "robotObserver", "targetHandle": "robotObserver", "type": "default", "data": { "type": "object" } },
    { "id": "e-robot-decision-planner", "source": "robot-operator-input", "target": "planner-context", "sourceHandle": "plannerDecision", "targetHandle": "plannerDecision", "type": "default", "data": { "type": "object" } },
    { "id": "e-robot-memories-planner", "source": "robot-operator-input", "target": "planner-context", "sourceHandle": "memories", "targetHandle": "delegatedMemories", "type": "default", "data": { "type": "array" } },
    { "id": "e-robot-observed-at-planner", "source": "robot-operator-input", "target": "planner-context", "sourceHandle": "sourceObservationAt", "targetHandle": "sourceObservationAt", "type": "default", "data": { "type": "string" } },
    { "id": "e-robot-visual-planner", "source": "robot-operator-input", "target": "planner-context", "sourceHandle": "currentVisualEvidence", "targetHandle": "currentVisualEvidence", "type": "default", "data": { "type": "boolean" } },
    { "id": "e-robot-observer-dispatch", "source": "robot-operator-input", "target": "environment-dispatch", "sourceHandle": "robotObserver", "targetHandle": "robotObserver", "type": "default", "data": { "type": "object" } },
    {
      "id": "e-policy-context",
      "source": "planner-policy",
      "target": "planner-context",
      "sourceHandle": "text",
      "targetHandle": "instruction",
      "type": "default",
      "data": { "type": "string" }
    },
    {
      "id": "e-observation-context",
      "source": "observation",
      "target": "planner-context",
      "sourceHandle": "observation",
      "targetHandle": "observation",
      "type": "default",
      "data": { "type": "object" }
    },
    {
      "id": "e-status-context",
      "source": "robot-status",
      "target": "planner-context",
      "sourceHandle": "context",
      "targetHandle": "robotStatus",
      "type": "default",
      "data": { "type": "object" }
    },
    {
      "id": "e-memory-context",
      "source": "memory-sampler",
      "target": "planner-context",
      "sourceHandle": "memories",
      "targetHandle": "memoryContext",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-conversation-context",
      "source": "conversation-history",
      "target": "planner-context",
      "sourceHandle": "history",
      "targetHandle": "conversationHistory",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-inner-context",
      "source": "inner-history",
      "target": "planner-context",
      "sourceHandle": "history",
      "targetHandle": "innerHistory",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-robot-context",
      "source": "robot-history",
      "target": "planner-context",
      "sourceHandle": "history",
      "targetHandle": "actionHistory",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-persona-loader-formatter",
      "source": "persona-loader",
      "target": "persona-formatter",
      "sourceHandle": "persona",
      "targetHandle": "persona",
      "type": "default",
      "data": { "type": "object" }
    },
    {
      "id": "e-persona-context",
      "source": "persona-formatter",
      "target": "planner-context",
      "sourceHandle": "formatted",
      "targetHandle": "personaText",
      "type": "default",
      "data": { "type": "string" }
    },
    {
      "id": "e-context-messages-planner",
      "source": "planner-context",
      "target": "planner",
      "sourceHandle": "messages",
      "targetHandle": "messages",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-context-schema-planner",
      "source": "planner-context",
      "target": "planner",
      "sourceHandle": "jsonSchema",
      "targetHandle": "jsonSchema",
      "type": "default",
      "data": { "type": "object" }
    },
    {
      "id": "e-planner-parser",
      "source": "planner",
      "target": "decision-parser",
      "sourceHandle": "response",
      "targetHandle": "response",
      "type": "default",
      "data": { "type": "llm_response" }
    },
    {
      "id": "e-parser-dispatch",
      "source": "decision-parser",
      "target": "environment-dispatch",
      "sourceHandle": "decision",
      "targetHandle": "decision",
      "type": "default",
      "data": { "type": "object" }
    },
    {
      "id": "e-memory-dispatch",
      "source": "memory-sampler",
      "target": "environment-dispatch",
      "sourceHandle": "memories",
      "targetHandle": "memories",
      "type": "default",
      "data": { "type": "array" }
    },
    {
      "id": "e-observation-dispatch",
      "source": "observation",
      "target": "environment-dispatch",
      "sourceHandle": "observation",
      "targetHandle": "observation",
      "type": "default",
      "data": { "type": "object" }
    }
  ]
}
