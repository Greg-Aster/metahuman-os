      "id": "observation",
      "type": "environmentNode",
      "position": {
        "x": 40,
        "y": 260
      },
      "data": {
        "label": "Current Robot State and Capabilities",
        "nodeType": "environment_bridge_input",
        "properties": {},
        "comment": "Makes the complete read-only Environment Bridge contract available. This workflow connects only current state and capabilities for reflection; the input node has no prompt or direct effect."
      }
    },
    {
      "id": "planner-policy",
      "type": "inputNode",
      "position": {
        "x": 40,
        "y": -80
      },
      "data": {
        "label": "Editable Reflection Planner Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Reflection planner. Let the sampled memory interact with the active persona, recent conversation and reflection, current robot state, and verified prior actions to form one new high-level intention with a consequence now. Preserve a concrete connection to the memory without merely summarizing it or treating it as present-world evidence. Do not choose a technical command, completion rule, or execution sequence. Return only the configured JSON decision.",
          "inputKey": ""
        }
      }
    },
