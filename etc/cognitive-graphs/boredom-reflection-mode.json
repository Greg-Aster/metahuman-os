{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Reflection Mode",
  "description": "Samples historical memory once and delegates the choice of private reflection, conversation, or advertised action to Boredom Autonomy.",
  "cognitiveMode": "environment",
  "last_modified": "2026-08-24",
  "nodes": [
    {
      "id": "observation",
      "type": "environmentNode",
      "position": { "x": 60, "y": 180 },
      "data": { "label": "Reflection Opportunity", "nodeType": "environment_observation", "properties": {} }
    },
    {
      "id": "memory-sampler",
      "type": "cognitiveNode",
      "position": { "x": 60, "y": -80 },
      "data": {
        "label": "Sample Historical Memory",
        "nodeType": "curiosity_weighted_sampler",
        "properties": { "sampleSize": 1, "decayFactor": 30 }
      }
    },
    {
      "id": "instructions",
      "type": "inputNode",
      "position": { "x": 350, "y": -80 },
      "data": {
        "label": "Reflection Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "Treat the supplied sampled memory as historical inspiration for Boredom Autonomy. The executive must use it with persona, current evidence, and correlated episode state to author or revise its own intent and choose the next consequence; this trigger does not choose it. Preserve a concrete memory detail without merely summarizing it. A memory is narrative context, never evidence of current objects, people, hazards, or physical clearance.",
          "inputKey": ""
        }
      }
    },
    {
      "id": "environment-dispatch",
      "type": "operatorNode",
      "position": { "x": 720, "y": 170 },
      "data": {
        "label": "Delegate to Boredom Autonomy",
        "nodeType": "robot_operator_environment_dispatch",
        "properties": { "graph": "boredom-autonomy", "requireAction": false }
      }
    }
  ],
  "edges": [
    { "id": "e-observation-dispatch", "source": "observation", "target": "environment-dispatch", "sourceHandle": "observation", "targetHandle": "observation", "type": "default", "data": { "type": "object" } },
    { "id": "e-memory-dispatch", "source": "memory-sampler", "target": "environment-dispatch", "sourceHandle": "memories", "targetHandle": "memories", "type": "default", "data": { "type": "array" } },
    { "id": "e-instructions-dispatch", "source": "instructions", "target": "environment-dispatch", "sourceHandle": "text", "targetHandle": "instruction", "type": "default", "data": { "type": "string" } }
  ]
}
