      "type": "llmNode",
      "position": { "x": 1090, "y": 180 },
      "width": 230,
      "height": 120,
      "data": {
        "label": "Boredom Vision LLM",
        "nodeType": "model_router",
        "properties": {
          "role": "persona",
          "maxTokens": 384,
          "temperature": 0.45
        }
      }
    },
    {
