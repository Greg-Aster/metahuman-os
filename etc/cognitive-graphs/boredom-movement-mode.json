{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Movement Mode",
  "description": "Uses current robot state, persona, recent narrative, and verified action history to author one embodied intention for Boredom Autonomy to execute.",
  "cognitiveMode": "environment",
  "last_modified": "2026-09-02",
  "nodes": [
    {
      "id": "observation",
      "type": "environmentNode",
      "position": { "x": 40, "y": 260 },
      "data": {
        "label": "Current Robot State and Capabilities",
        "nodeType": "environment_bridge_input",
        "properties": {},
        "comment": "Supplies the current bridge observation and advertised robot capabilities to the movement planner. It is read-only and sends no command."
      }
    },
    {
      "id": "planner-policy",
      "type": "inputNode",
      "position": { "x": 40, "y": -80 },
      "data": {
        "label": "Editable Movement Planner Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Movement planner. Use the active persona, current body and environment state, recent conversation and reflection, verified prior actions, and advertised capabilities to decide one contextually meaningful embodied intention that begins with a physical change now because remaining inactive no longer fits this moment. Let the current situation, persona, goals, and recent events determine the intended effect; use history as context, not current physical proof. Use recent verified actions only to break a genuine tie between equally fitting possibilities; never choose novelty or difference for its own sake. Author the intended physical change at a human level; waiting, holding position, or merely observing is not a movement intention. Do not select a technical command, joint angle, completion rule, or execution sequence. Return only the configured JSON decision.",
          "inputKey": ""
        }
      }
    },
    {
      "id": "conversation-history",
      "type": "contextNode",
      "position": { "x": 40, "y": 500 },
      "data": {
        "label": "Recent Conversation",
        "nodeType": "conversation_history",
        "properties": { "mode": "conversation", "limit": 4 }
      }
    },
    {
      "id": "inner-history",
      "type": "contextNode",
      "position": { "x": 300, "y": 500 },
      "data": {
        "label": "Recent Reflection",
        "nodeType": "conversation_history",
        "properties": { "mode": "inner", "limit": 2 }
      }
    },
    {
      "id": "robot-history",
      "type": "contextNode",
      "position": { "x": 560, "y": 500 },
      "data": {
        "label": "Verified Robot Action History",
        "nodeType": "conversation_history",
        "properties": { "mode": "robot", "limit": 20 }
      }
    },
    {
      "id": "persona-loader",
      "type": "personaNode",
      "position": { "x": 40, "y": 700 },
      "data": {
        "label": "Active Persona",
        "nodeType": "persona_loader",
        "properties": {}
      }
    },
    {
      "id": "persona-formatter",
      "type": "personaNode",
      "position": { "x": 300, "y": 700 },
      "data": {
        "label": "Compact Persona Context",
        "nodeType": "persona_formatter",
        "properties": {
          "includeValues": true,
          "includeGoals": true,
          "includePersonality": true
        }
      }
    },
    {
      "id": "planner-context",
      "type": "operatorNode",
      "position": { "x": 850, "y": 220 },
      "data": {
        "label": "Build Movement Planning Context",
        "nodeType": "robot_operator_context_builder",
        "properties": { "outputContract": "delegation" }
      }
    },
    {
      "id": "planner",
      "type": "llmNode",
      "position": { "x": 1240, "y": 220 },
      "data": {
        "label": "Author Embodied Intention",
        "nodeType": "model_router",
        "properties": {
          "role": "persona",
          "maxTokens": 384,
          "temperature": 0.7,
          "format": "json"
        }
      }
    },
    {
      "id": "decision-parser",
      "type": "operatorNode",
      "position": { "x": 1530, "y": 220 },
      "data": {
        "label": "Validate Planner Instruction",
        "nodeType": "robot_operator_decision_parser",
        "properties": {}
      }
    },
    {
      "id": "environment-dispatch",
      "type": "operatorNode",
      "position": { "x": 1840, "y": 220 },
      "data": {
        "label": "Send Intention to Boredom Autonomy",
        "nodeType": "robot_operator_environment_dispatch",
        "properties": { "graph": "boredom-autonomy" }
      }
    }
  ],
