{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Observer Mode",
  "description": "Requests one correlated robot-camera image without an LLM call, then routes the returned frame and editable observation stimulus to Boredom Autonomy.",
  "cognitiveMode": "environment",
  "last_modified": "2026-08-24",
  "nodes": [
    {
      "id": "observation",
      "type": "environmentNode",
      "position": { "x": 60, "y": 220 },
      "data": {
        "label": "Robot Session and Capabilities",
        "nodeType": "environment_observation",
        "properties": {}
      }
    },
    {
      "id": "observer-policy",
      "type": "inputNode",
      "position": { "x": 60, "y": -80 },
      "data": {
        "label": "Editable Observer Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "Treat the returned fresh robot-camera image as autonomous input for Boredom Autonomy. The executive must use current evidence to author or revise its own episode intent and choose the next consequence; this trigger does not choose it. Do not stop at captioning the scene or generic readiness. The correlated image is present evidence, while conversation, reflection, and memories provide narrative continuity only.",
          "inputKey": ""
        }
      }
    },
    {
      "id": "capture-command",
      "type": "inputNode",
      "position": { "x": 360, "y": 70 },
      "data": {
        "label": "Editable Camera Request",
        "nodeType": "text_input",
        "properties": {
          "message": "{\"type\":\"captureImage\"}",
          "inputKey": ""
        }
      }
    },
    {
      "id": "parse-capture",
      "type": "utilityNode",
      "position": { "x": 670, "y": 70 },
      "data": {
        "label": "Parse Camera Request",
        "nodeType": "json_parser",
        "properties": {}
      }
    },
    {
      "id": "capture-image",
      "type": "environmentNode",
      "position": { "x": 990, "y": 190 },
      "data": {
        "label": "Request Image and Continue in Boredom Autonomy",
        "nodeType": "environment_send_action",
        "properties": {
          "allowedActions": ["captureImage"],
          "maxDurationMs": 1500,
          "defaultDurationMs": 0,
          "feedbackGraph": "boredom-autonomy"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-command-parser",
      "source": "capture-command",
      "target": "parse-capture",
      "sourceHandle": "text",
      "targetHandle": "text",
      "type": "default",
      "data": { "type": "string", "comment": "Visible editable captureImage action" }
    },
    {
      "id": "e-parser-action",
      "source": "parse-capture",
      "target": "capture-image",
      "sourceHandle": "data",
      "targetHandle": "action",
      "type": "default",
      "data": { "type": "object", "comment": "One capability-checked camera action" }
    },
    {
      "id": "e-observation-session",
      "source": "observation",
      "target": "capture-image",
      "sourceHandle": "sessionId",
      "targetHandle": "sessionId",
      "type": "default",
      "data": { "type": "string", "comment": "Connected robot session" }
    },
    {
      "id": "e-policy-instruction",
      "source": "observer-policy",
      "target": "capture-image",
      "sourceHandle": "text",
      "targetHandle": "taskInstruction",
      "type": "default",
      "data": { "type": "string", "comment": "Carry the editable observer policy with the returned frame" }
    }
  ]
}
