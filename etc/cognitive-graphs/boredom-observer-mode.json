        "nodeType": "text_input",
        "properties": {
          "message": "{\"type\":\"captureImage\"}",
          "inputKey": ""
        }
      }
    },
    {
      "id": "parse-capture",
      "type": "utilityNode",
      "position": { "x": 1120, "y": -120 },
