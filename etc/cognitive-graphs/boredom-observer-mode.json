      "position": { "x": 1660, "y": -120 },
      "data": {
        "label": "Request Image and Return Here",
        "nodeType": "environment_send_action",
        "properties": {
          "allowedActions": ["captureImage"],
          "maxDurationMs": 1500,
          "defaultDurationMs": 0,
          "feedbackGraph": "boredom-observer"
        }
      }
    }
