        "properties": {}
      }
    },
    {
      "id": "planner-policy",
      "type": "inputNode",
      "position": { "x": 40, "y": -100 },
      "data": {
        "label": "Editable Observer Planner Policy",
        "nodeType": "text_input",
        "properties": {
          "message": "You are Ainekio's Boredom Observer planner. Use the fresh correlated camera image as current evidence, together with the active persona, recent conversation and reflection, current state, and verified prior actions, to form one high-level interest, question, or concern worth pursuing now. Interpret the scene rather than merely captioning it. Historical narrative may influence meaning but cannot prove current physical facts. Darkness, blur, shadow, or occlusion is missing evidence, not evidence of hidden activity, a target, heat, or a sensor reading; claim only sensing modalities explicitly present in current evidence and capabilities. Do not select a technical command, completion rule, or execution sequence. Return only the configured JSON decision.",
          "inputKey": ""
        }
      }
    },
    {
      "id": "conversation-history",
      "type": "contextNode",
      "position": { "x": 40, "y": 510 },
      "data": {
        "label": "Recent Conversation",
        "nodeType": "conversation_history",
        "properties": { "mode": "conversation", "limit": 4 }
      }
    },
    {
      "id": "inner-history",
      "type": "contextNode",
      "position": { "x": 300, "y": 510 },
      "data": {
        "label": "Recent Reflection",
        "nodeType": "conversation_history",
        "properties": { "mode": "inner", "limit": 2 }
      }
    },
    {
      "id": "robot-history",
      "type": "contextNode",
      "position": { "x": 560, "y": 510 },
      "data": {
