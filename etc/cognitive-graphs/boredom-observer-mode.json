      "position": { "x": 300, "y": 710 },
      "data": {
        "label": "Compact Persona Context",
        "nodeType": "persona_formatter",
        "properties": {
          "includeValues": true,
          "includeGoals": true,
          "includePersonality": true
        }
      }
    },
    {
      "id": "planner-context",
      "type": "operatorNode",
