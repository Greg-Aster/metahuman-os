        "nodeType": "model_router",
        "properties": {
          "role": "persona",
          "maxTokens": 384,
          "temperature": 0.7,
          "format": "json"
        }
      }
    },
    {
      "id": "decision-parser",
      "type": "operatorNode",
      "position": { "x": 1800, "y": 190 },
