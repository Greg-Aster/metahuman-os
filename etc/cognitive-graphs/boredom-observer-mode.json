{
  "version": "1.0",
  "format": "svelte-flow",
  "name": "Boredom Observer Mode",
  "description": "Acquires one correlated camera frame, then uses it with persona, recent narrative, and verified action history to author an intention for Boredom Autonomy.",
  "cognitiveMode": "environment",
  "last_modified": "2026-08-25",
  "nodes": [
    {
      "id": "observation",
      "type": "environmentNode",
      "position": { "x": 40, "y": 260 },
      "data": {
        "label": "Current Robot Stimulus",
        "nodeType": "environment_observation",
        "properties": {}
      }
    },
    {
      "id": "image-input",
      "type": "environmentNode",
      "position": { "x": 300, "y": 260 },
