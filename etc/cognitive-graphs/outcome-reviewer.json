{
  "version": "1.0",
  "format": "svelte-flow",
  "scheduler": { "version": 1, "activation": "demand", "skippedState": "explicit", "sideEffectOrder": "serial-topological", "maxLoopIterations": 5 },
  "name": "Outcome Reviewer",
  "description": "Reviews one desire execution, applies the canonical Agency transition, then publishes the durable result",
  "cognitiveMode": "agent",
  "last_modified": "2026-08-25",
  "nodes": [
    {
      "id": "load-desire",
      "type": "genericNode",
      "position": { "x": 100, "y": 180 },
      "data": {
        "label": "Load Executed Desire",
        "nodeType": "desire_loader",
        "properties": {}
      },
      "width": 200,
      "height": 80
    },
    {
      "id": "review-outcome",
      "type": "genericNode",
      "position": { "x": 380, "y": 180 },
      "data": {
        "label": "Review Outcome",
        "nodeType": "outcome_reviewer",
        "properties": {
          "temperature": 0.3
        }
      },
      "width": 220,
      "height": 100
    },
    {
      "id": "apply-outcome",
      "type": "agencyNode",
      "position": { "x": 680, "y": 180 },
      "data": {
        "label": "Apply Agency Transition",
        "nodeType": "desire_updater",
        "properties": {
          "applyOutcomePolicy": true
        }
      },
      "width": 220,
      "height": 100
    },
    {
      "id": "inner-dialogue",
      "type": "outputNode",
      "position": { "x": 980, "y": 100 },
      "data": {
        "label": "Save to Inner Dialogue",
        "nodeType": "inner_dialogue_buffer",
        "properties": {
          "tags": ["agency", "outcome-review", "inner"],
          "dialogueSource": "outcome-reviewer"
        }
      },
      "width": 200,
      "height": 80
    },
    {
      "id": "tts-output",
      "type": "outputNode",
      "position": { "x": 1280, "y": 220 },
      "data": {
        "label": "TTS Output",
        "nodeType": "tts",
        "properties": {
          "source": "outcome-reviewer",
          "defaultMode": "inner"
        }
      },
      "width": 180,
      "height": 60
    },
    {
      "id": "inner-memory",
      "type": "cognitiveNode",
      "position": { "x": 1280, "y": 100 },
      "data": {
        "label": "Save Inner Dialogue Memory",
        "nodeType": "inner_dialogue_saver",
        "properties": {}
      },
      "width": 240,
      "height": 90
    },
    {
      "id": "audit-result",
      "type": "outputNode",
      "position": { "x": 980, "y": 340 },
      "data": {
        "label": "Audit Durable Result",
        "nodeType": "audit_logger",
        "properties": {
          "category": "decision",
          "event": "outcome_reviewed"
        }
      },
      "width": 180,
      "height": 60
    }
  ],
  "edges": [
    {
      "id": "load-to-review",
      "source": "load-desire",
      "target": "review-outcome",
      "sourceHandle": "desire",
      "targetHandle": "desire",
      "data": { "type": "object", "comment": "Desire to reviewer" }
    },
    {
      "id": "load-to-apply",
      "source": "load-desire",
      "target": "apply-outcome",
      "sourceHandle": "desire",
      "targetHandle": "desire",
      "data": { "type": "object", "comment": "Original desire to canonical transition" }
    },
    {
      "id": "review-to-apply",
      "source": "review-outcome",
      "target": "apply-outcome",
      "sourceHandle": "outcomeReview",
      "targetHandle": "outcomeReview",
      "data": { "type": "object", "comment": "Validated review to canonical transition" }
    },
    {
      "id": "apply-to-inner",
      "source": "apply-outcome",
      "target": "inner-dialogue",
      "sourceHandle": "summary",
      "targetHandle": "text",
      "data": { "type": "string", "comment": "Durable transition summary" }
    },
    {
      "id": "inner-to-memory",
      "source": "inner-dialogue",
      "target": "inner-memory",
      "sourceHandle": "entries",
      "targetHandle": "entries",
      "data": { "type": "array", "comment": "Buffer-admitted transition summary to Persona Memory" }
    },
    {
      "id": "memory-to-tts",
      "source": "inner-memory",
      "target": "tts-output",
      "sourceHandle": "text",
      "targetHandle": "innerDialogue",
      "data": { "type": "string", "comment": "Long-term persisted transition summary" }
    },
    {
      "id": "apply-to-audit",
      "source": "apply-outcome",
      "target": "audit-result",
      "sourceHandle": "desire",
      "targetHandle": "data",
      "data": { "type": "object", "comment": "Durably updated desire" }
    }
  ]
}
