      "type": "operatorNode",
      "position": { "x": 2380, "y": 150 },
      "width": 290,
      "height": 150,
      "data": {
        "label": "Delegate to Environment Mode",
        "nodeType": "robot_operator_environment_dispatch",
        "properties": {
          "graph": "environment",
          "maxSteps": 8
        }
      }
    },
    {
      "id": "reason-inner-dialogue",
      "type": "outputNode",
      "position": { "x": 2040, "y": 560 },
      "width": 280,
      "height": 150,
      "data": {
