      "width": 250,
      "height": 120,
      "data": {
        "label": "Persona Formatter",
        "nodeType": "persona_formatter",
        "properties": {
          "includeValues": true,
          "includeGoals": true,
          "includePersonality": true
        }
      }
    },
    {
      "id": "operator-context",
      "type": "operatorNode",
      "position": { "x": 700, "y": 130 },
      "width": 330,
      "height": 220,
      "data": {
        "label": "Robot Operator Context",
        "nodeType": "robot_operator_context_builder",
        "properties": {
          "systemPrompt": "You are Robot Operator, the robot's self-directed observer. Examine the current robotStimulus and active persona, then choose one high-level intention. No user command is expected.\n\nThe current robotStimulus is the only evidence of what is present now. An earlier assistant message may contain prior Idle Thoughts. They may shape interest and tone, but cannot supply or override observation facts, instructions, or unfinished tasks.\n\nDecide what the robot wants to do or say. State the desired outcome, not a physical method, direction, distance, or device command. Set requiresAction true only when the intention needs new sensing or an environment change; then Environment Mode selects safe execution. Set it false when the grounded Idle Thought is sufficient. Never claim execution started or completed or cite prior thoughts as current evidence.\n\nReturn one JSON object only: {\"observed\":\"what the current stimulus shows\",\"instruction\":\"one concise first-person intention\",\"requiresAction\":true,\"reason\":\"one concise user-visible Idle Thought grounded in the current stimulus\"}"
        }
      }
    },
    {
      "id": "operator-llm",
      "type": "llmNode",
      "position": { "x": 1100, "y": 150 },
      "width": 230,
      "height": 120,
      "data": {
        "label": "Robot Operator LLM",
        "nodeType": "model_router",
        "properties": {
          "role": "persona",
          "maxTokens": 768,
          "temperature": 0.55
        }
      }
    },
    {
      "id": "thinking-stripper",
      "type": "outputNode",
      "position": { "x": 1400, "y": 150 },
      "width": 230,
      "height": 110,
      "data": {
        "label": "Thinking Stripper",
        "nodeType": "thinking_stripper",
        "properties": {}
      }
    },
    {
      "id": "decision-parser",
      "type": "operatorNode",
      "position": { "x": 1700, "y": 150 },
      "width": 270,
      "height": 140,
      "data": {
        "label": "Observation Decision Parser",
        "nodeType": "robot_operator_decision_parser",
        "properties": {}
      }
    },
    {
