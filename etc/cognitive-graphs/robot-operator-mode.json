        "nodeType": "inner_dialogue_buffer",
        "properties": {
          "tags": ["robot-operator", "observation", "decision-rationale", "idle-thought", "inner"],
          "dialogueSource": "robot-operator-mode",
          "role": "reflection",
          "captureMemory": false
        }
      }
    },
    {
      "id": "idle-thought-tts",
      "type": "outputNode",
      "position": { "x": 2380, "y": 560 },
      "width": 280,
      "height": 140,
      "data": {
