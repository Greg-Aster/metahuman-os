{
  "version": "2.0",
  "format": "svelte-flow",
  "scheduler": { "version": 1, "activation": "demand", "skippedState": "explicit", "sideEffectOrder": "serial-topological", "maxLoopIterations": 5 },
  "name": "Organizer Agent",
  "description": "Enriches one Core-selected episodic memory with validated tags and entities, then persists through the canonical memory owner",
  "cognitiveMode": "agent",
  "nodes": [
    {
      "id": "memory-input",
      "type": "agentNode",
      "position": {
        "x": 100,
        "y": 100
      },
      "data": {
        "label": "organizer_memory_input",
        "nodeType": "memory_loader",
        "properties": {}
      }
    },
    {
      "id": "enrich-memory",
      "type": "agentNode",
      "position": {
        "x": 460,
        "y": 100
      },
      "data": {
        "label": "llm_enricher",
        "nodeType": "llm_enricher",
        "properties": {
          "systemPrompt": "You extract concise semantic metadata from saved episodic memory content. Return only the requested JSON object.",
          "promptTemplate": "Analyze this saved episodic memory content and extract relevant tags and named entities.\n\nMemory:\n{{content}}\n\nReturn JSON with two arrays: {\"tags\": [\"topic\"], \"entities\": [\"name\"]}. Use short strings and return empty arrays when none apply.",
          "role": "curator",
          "temperature": 0.3,
          "maxTokens": 512,
          "repeatPenalty": 1.15
        }
      }
    },
    {
      "id": "save-memory",
      "type": "agentNode",
      "position": {
        "x": 840,
        "y": 100
      },
      "data": {
        "label": "memory_saver",
        "nodeType": "memory_saver",
        "properties": {}
      }
    }
  ],
  "edges": [
    {
      "id": "memory-input-memory-enrich-memory-memory",
      "source": "memory-input",
      "target": "enrich-memory",
      "sourceHandle": "memory",
      "targetHandle": "memory",
      "data": {}
    },
    {
      "id": "enrich-memory-memory-save-memory-memory",
      "source": "enrich-memory",
      "target": "save-memory",
      "sourceHandle": "memory",
      "targetHandle": "memory",
      "data": {}
    },
    {
      "id": "enrich-memory-outcome-save-memory-outcome",
      "source": "enrich-memory",
      "target": "save-memory",
      "sourceHandle": "outcome",
      "targetHandle": "outcome",
      "data": {}
    }
  ]
}
