#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SERVER_ENTRY="$REPO_ROOT/apps/site/dist/server/entry.mjs"

if ! command -v pm2 >/dev/null 2>&1; then
  echo "PM2 is required. Install it explicitly before using background mode." >&2
  exit 1
fi

if [ ! -f "$SERVER_ENTRY" ]; then
  echo "Production server bundle is missing." >&2
  echo "Run: pnpm --dir apps/site build" >&2
  exit 1
fi

if pm2 describe metahuman-os >/dev/null 2>&1; then
  echo "MetaHuman OS is already registered with PM2." >&2
  echo "Run ./bin/stop-pm2 before starting it again." >&2
  exit 1
fi

mkdir -p "$REPO_ROOT/logs/pm2"
cd "$REPO_ROOT"
pm2 start ecosystem.config.js

echo "MetaHuman OS is running under PM2 at http://localhost:4321"
echo "Use 'pm2 logs metahuman-os' for logs and './bin/stop-pm2' to stop it."
