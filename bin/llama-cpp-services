#!/usr/bin/env bash

set -euo pipefail

case "${1:-}" in
  start)
    systemctl --user start \
      llama-cpp.service \
      llama-cpp-environment-2b.service
    ;;
  stop)
    services=(llama-cpp.service llama-cpp-environment-intent.service llama-cpp-environment-speck-intent.service)
    optional_state=$(systemctl --user show --property=LoadState --value llama-cpp-environment-2b.service)
    if [[ "$optional_state" != "not-found" ]]; then
      services+=(llama-cpp-environment-2b.service)
    fi
    systemctl --user stop "${services[@]}"
    ;;
  *)
    echo "Usage: $0 start|stop" >&2
    exit 2
    ;;
esac
