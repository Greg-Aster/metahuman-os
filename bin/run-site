#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "$#" -eq 0 ]; then
  echo "Usage: run-site <command> [args...]" >&2
  exit 1
fi

mkdir -p "$REPO_ROOT/logs"
cd "$REPO_ROOT/apps/site"
"$@" 2>&1 | tee "$REPO_ROOT/logs/server.log"
