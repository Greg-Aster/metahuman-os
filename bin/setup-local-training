#!/usr/bin/env bash
# Setup script for local LoRA training environment

set -euo pipefail

echo "🔧 Setting up local training environment..."
echo ""

# Check for NVIDIA GPU
if ! command -v nvidia-smi &> /dev/null; then
    echo "❌ nvidia-smi not found. This requires an NVIDIA GPU with CUDA support."
    exit 1
fi

echo "✅ NVIDIA GPU detected:"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
echo ""

# Create/activate venv
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV_DIR="$ROOT_DIR/venv"

if [ ! -d "$VENV_DIR" ]; then
    echo "📦 Creating virtual environment..."
    python3 -m venv "$VENV_DIR"
else
    echo "✅ Virtual environment exists at $VENV_DIR"
fi

echo "📦 Activating virtual environment..."
source "$VENV_DIR/bin/activate"

# Upgrade pip
echo "📦 Upgrading pip..."
pip install --upgrade pip

# Keep local and remote training on the same compatible versions.
echo "📦 Installing the repository's training dependency contract..."
python -m pip install -r "$ROOT_DIR/docker/runpod-trainer/requirements.txt"
python -m pip check
python "$ROOT_DIR/docker/runpod-trainer/train_unsloth.py" --check-environment

echo ""
echo "✅ Setup complete!"
echo ""
echo "To use local training:"
echo "  1. Activate venv: source venv/bin/activate"
echo "  2. Run training: pnpm exec tsx brain/training/personalization/full-cycle-local.ts --username <username>"
echo ""
echo "Or the venv will be used automatically if you run:"
echo "  pnpm exec tsx brain/training/personalization/full-cycle-local.ts --username <username>"
