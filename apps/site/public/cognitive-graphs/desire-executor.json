        "comment": "Buffer-admitted execution summary to Persona Memory"
      }
    },
    {
      "id": "e-9-text-8-innerDialogue",
      "source": "9",
      "target": "8",
      "sourceHandle": "text",
      "targetHandle": "innerDialogue",
      "data": {
        "type": "string",
        "comment": "Long-term persisted Inner Dialogue to TTS"
      }
