        "type": "string",
        "comment": "Execution Summary to Inner Dialogue",
        "when": {
          "output": "hasNext",
          "equals": false
        }
      }
    },
    {
      "id": "e-7-entries-9-entries",
      "source": "7",
      "target": "9",
