    {
      "id": "e-3-desire-prepare-desire",
      "source": "3",
      "sourceHandle": "desire",
      "target": "prepare",
      "targetHandle": "desire",
      "data": {
        "type": "object",
        "loop": true,
        "when": {
          "output": "hasNext",
          "equals": true
        }
      }
    }
